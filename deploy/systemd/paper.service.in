[Unit]
Description=Paper Minecraft Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@PAPER_DIR@
EnvironmentFile=@INSTALL_DIR@/.env
ExecStart=@INSTALL_DIR@/deploy/paper-service.sh start
ExecStop=@INSTALL_DIR@/deploy/paper-service.sh stop
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
