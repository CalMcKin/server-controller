# Select where this copy of the repository will run:
# controller = web UI only; game-server = Paper plus authenticated API; all = one host.
DEPLOY_ROLE="all"

# How the web UI talks to Paper: local for one host, remote for a separate game host.
CONTROL_MODE="local"

# Address the web UI/API listens on; use 0.0.0.0 to accept LAN traffic.
CONTROLLER_BIND="0.0.0.0"
# TCP port for the web UI/API.
CONTROLLER_PORT="8765"
# IP address or hostname users enter in their browser.
CONTROLLER_HOST="127.0.0.1"

# Base URL of the API on the Minecraft machine, e.g. https://mc-host.example:8766.
# Use HTTPS or a trusted VPN/private network; do not expose this API to the public internet.
REMOTE_API_URL=""
# Shared random bearer token. Set the same secret on the controller and game-server hosts.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
REMOTE_API_TOKEN=""

# Address the game-server API listens on; firewall this port to the controller host.
# Use 0.0.0.0 when the controller connects over the network.
AGENT_BIND="127.0.0.1"
# TCP port used by the game-server API.
AGENT_PORT="8766"

# Display name shown in the web UI.
SERVER_NAME="Minecraft"
# Minecraft Java status address. In the game-server .env, use 127.0.0.1.
SERVER_IP="127.0.0.1"
# Minecraft Java status port; not editable in the Settings tab.
SERVER_PORT="25565"
# Image filename in this repository's root, shown as the server logo.
SERVER_IMAGE="grandell.png"

# systemd unit name for the Paper server.
PAPER_SERVICE="paper.service"
# Existing Paper server directory containing an executable start.sh.
PAPER_DIR="/home/calmc/paper"
# tmux socket name used by Paper and the game-server API.
TMUX_SOCKET="paper"
# tmux session name used by Paper and the game-server API.
TMUX_SESSION="paper"
# tmux pane target used to read logs and send console commands.
TMUX_TARGET="paper:0.0"
